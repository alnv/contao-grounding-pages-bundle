<section<?php if ($this->anchor): ?> id=""<?php endif; ?>>
    <?php if ($headline = $this->headline['value'] ?? ''): ?>
        <<?= $this->headline['hl'] ?? 'h1' ?>><?= $headline ?></<?= $this->headline['hl'] ?? 'h1' ?>>
    <?php endif; ?>

    <?php if ($this->text): ?>
        <?= $this->text ?>
    <?php endif; ?>

    <?php if ($subheadline = $this->sub_headline['value'] ?? ''): ?>
        <<?= $this->sub_headline['hl'] ?? 'h1' ?>><?= $subheadline ?></<?= $this->sub_headline['hl'] ?? 'h1' ?>>
    <?php endif; ?>

    <?php if (!empty($this->faqs)): ?>
        <?php foreach ($this->faqs as $faq): ?>
            <<?= $faq['question']['hl'] ?? 'h3' ?>><?= $faq['question']['value'] ?? '' ?></<?= $faq['question']['hl'] ?? 'h3' ?>>
            <p><?= $faq['answer'] ?? ''?></p>
        <?php endforeach; ?>
    <?php endif; ?>
</section>