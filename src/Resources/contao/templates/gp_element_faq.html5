<section<?php if ($this->anchor): ?> id="<?= $this->anchor ?>"<?php endif; ?>>
    <?php if ($headline = $this->headline['value'] ?? ''): ?>
        <<?= $this->headline['unit'] ?? 'h2' ?>><?= $headline ?></<?= $this->headline['unit'] ?? 'h2' ?>>
    <?php endif; ?>

    <?php if ($this->text): ?>
        <?= $this->text ?>
    <?php endif; ?>

    <?php if ($subheadline = $this->sub_headline['value'] ?? ''): ?>
        <<?= $this->sub_headline['unit'] ?? 'h3' ?>><?= $subheadline ?></<?= $this->sub_headline['unit'] ?? 'h3' ?>>
    <?php endif; ?>

    <?php if (!empty($this->faqs)): ?>
        <?php foreach ($this->faqs as $faq): ?>
            <<?= $faq['question']['unit'] ?? 'h4' ?>><?= $faq['question']['value'] ?? '' ?></<?= $faq['question']['unit'] ?? 'h4' ?>>
            <p><?= $faq['answer'] ?? ''?></p>
        <?php endforeach; ?>
    <?php endif; ?>
</section>