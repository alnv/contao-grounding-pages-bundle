<section<?php if ($this->anchor): ?> id="<?= $this->anchor ?>"<?php endif; ?>>
    <?php if ($headline = $this->headline['value'] ?? ''): ?>
        <<?= $this->headline['hl'] ?? 'h1' ?>><?= $headline ?></<?= $this->headline['hl'] ?? 'h1' ?>>
    <?php endif; ?>

    <?php if ($this->text): ?>
        <?= $this->text ?>
    <?php endif; ?>

    <?php if ($subheadline = $this->sub_headline['value'] ?? ''): ?>
        <<?= $this->sub_headline['hl'] ?? 'h1' ?>><?= $subheadline ?></<?= $this->sub_headline['hl'] ?? 'h1' ?>>
    <?php endif; ?>

    <?php if (!empty($this->contents)): ?>
        <?php foreach ($this->contents as $faq): ?>
            <<?= $faq['headline']['hl'] ?? 'h3' ?>><?= $faq['headline']['value'] ?? '' ?></<?= $faq['headline']['hl'] ?? 'h3' ?>>
            <?= $faq['text'] ?? ''?>
        <?php endforeach; ?>
    <?php endif; ?>
</section>