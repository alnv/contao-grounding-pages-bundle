<section<?php if ($this->anchor): ?> id="<?= $this->anchor ?>"<?php endif; ?>>
    <?php if ($headline = $this->headline['value'] ?? ''): ?>
        <<?= $this->headline['unit'] ?? 'h2' ?>><?= $headline ?></<?= $this->headline['unit'] ?? 'h2' ?>>
    <?php endif; ?>

    <?php if ($this->text): ?>
        <?= $this->text ?>
    <?php endif; ?>

    <?php if ($subheadline = $this->sub_headline['value'] ?? ''): ?>
        <<?= $this->sub_headline['unit'] ?? 'h3' ?>><?= $subheadline ?></<?= $this->sub_headline['unit'] ?? 'h3' ?>>
    <?php endif; ?>
    <?php if (!empty($this->contents)): ?>
        <?php foreach ($this->contents as $content): ?>
            <?php
                $headline = \Contao\StringUtil::deserialize($content['headline'], true);
            ?>
            <?php if ($val = $headline['value'] ?? ''): ?>
            <<?= $headline['unit'] ?? 'h4' ?>><?= $val ?></<?= $headline['unit'] ?? 'h4' ?>>
            <?php endif; ?>
            <?= $content['text'] ?? ''?>
        <?php endforeach; ?>
    <?php endif; ?>
</section>